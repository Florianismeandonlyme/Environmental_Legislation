. quietly count if !missing(refered_law_id)

. di as txt _n "能匹配到 id 的引用：" r(N) " / " _N "（" %4.1f 100*r(N)/_N "%）
> "

能匹配到 id 的引用：4830 / 4830（100.0%）

. quietly count if refered_law_id == raw_law_id

. di as txt "自引（被引 id 与引用方相同）：" r(N) " 条"
