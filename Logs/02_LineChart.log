. local rn "东部 中部 西部"

. local kk = 0

. foreach r in east central west {
  2.     local ++kk
  3.     local nm : word `kk' of `rn'
  4.     quietly summarize inc_`r', meanonly
  5.     local peak = r(max)
  6.     quietly summarize publish_year if inc_`r' == `peak'
  7.     local yr = r(min)
  8.     di as txt "`nm'：增量峰值 `peak' 件，出现在 `yr' 年"
  9. }
