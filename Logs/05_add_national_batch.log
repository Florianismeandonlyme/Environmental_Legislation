. format publish %tc

. 
. * 正文通过框架链接取过来（避免把上万字塞进宏）
. frlink m:1 k1, frame(laws)
(113 observations in frame default unmatched)

. frget txt = content, from(laws)
(113 missing values generated)
(1 variable copied from linked frame)

. replace content = txt if !missing(k1)
(7 real changes made)

. drop k1 txt

. frame drop laws

. 
. *----------------------------------------------------------------------------
> -
. * 4. 校验后保存
. *----------------------------------------------------------------------------
> -
. quietly count

. if r(N) != `n0' + `nadd' {
.     di as err "条数异常，未保存。"
.     log close
.     exit
. }

. quietly count if missing(content)

. if r(N) > 0 {
.     di as err "有 " r(N) " 条正文为空，未保存。"
.     log close
.     exit
. }

. local n1 = _N

. save "$root/law_env_national.dta", replace
