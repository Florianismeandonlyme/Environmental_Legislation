. do Codes/05_add_national_batch.do 

. *============================================================================
> =
. * 05_add_national_batch.do
. * 目的：把 7 部被地方性法规高频援引、但不在国家级库中的法律法规补入
. *       law_env_national.dta
. *
. *   法律（6）：
. *     中华人民共和国民族区域自治法   npc.gov.cn
. *     中华人民共和国城乡规划法       npc.gov.cn
. *     中华人民共和国防洪法           mwr.gov.cn
. *     中华人民共和国农业法           npc.gov.cn（2026 年第二次修订，2027-01-0
> 1 施行）
. *     中华人民共和国长江保护法       mee.gov.cn
. *     中华人民共和国黄河保护法       mee.gov.cn
. *   行政法规（1）：
. *     城市供水条例                   国务院令第158号（原文见福建省住建厅转载
> 页）
. *
. * 字段填写说明：
. *   publish 取文本括注中的最后一个日期（最近一次修订/修正通过日）；
. *   env_level / env_topic 为人工归类：
. *      长江保护法、黄河保护法 → 1 核心环保
. *      城乡规划法 → 2 资源与生态 / 环境综合管理
. *      防洪法、城市供水条例、农业法 → 2 资源与生态
. *      民族区域自治法非环保专项法 → env_level 置缺失、env_topic 留空
. *   source_id 记录原文网址，便于回溯
. *
. * 输入：law_env_national.dta、Codes/_laws_batch.csv
. * 输出：law_env_national.dta、Logs/05_add_national_batch.log
. *============================================================================
> =
. 
. version 17

. clear all

. set more off

. global root "/Users/florian/Desktop/博士研究计划"

. capture mkdir "$root/Logs"

. capture log close

. log using "$root/Logs/05_add_national_batch.log", replace text
(file /Users/florian/Desktop/博士研究计划/Logs/05_add_national_batch.log not
    found)
-------------------------------------------------------------------------------
      name:  <unnamed>
       log:  /Users/florian/Desktop/博士研究计划/Logs/05_add_national_batch.log
  log type:  text
 opened on:   5 Nov 2026, 22:52:22

. 
. *----------------------------------------------------------------------------
> -
. * 1. 读入待补入清单
. *----------------------------------------------------------------------------
> -
. confirm file "$root/Codes/_laws_batch.csv"

. frame create laws

. frame laws {
.     import delimited "$root/Codes/_laws_batch.csv", clear varnames(1) ///
>         stringcols(_all) bindquote(strict) maxquotedrows(3000) ///
>         encoding("utf-8") case(preserve)
(7 vars, 7 obs)
.     gen long k1 = _n
.     quietly count
.     di as txt "待补入：" r(N) " 条"
待补入：7 条
. }

. frame laws: quietly count

. local nadd = r(N)

. 
. *----------------------------------------------------------------------------
> -
. * 2. 查重：任一标题已存在则整体不执行
. *----------------------------------------------------------------------------
> -
. use "$root/law_env_national.dta", clear

. quietly count

. local n0 = r(N)

. local dup = 0

. forvalues i = 1/`nadd' {
  2.     frame laws: local t = title[`i']
  3.     quietly count if title == "`t'"
  4.     if r(N) > 0 {
  5.         di as err "  已存在：`t'"
  6.         local ++dup
  7.     }
  8. }

. if `dup' > 0 {
.     di as err _n "存在重复记录，未做任何修改。请先核对 Codes/_laws_batch.csv
> 。"
.     log close
.     exit
. }

. di as txt "原有 `n0' 条，无重复，开始补入。"
原有 113 条，无重复，开始补入。

. 
. *----------------------------------------------------------------------------
> -
. * 3. 追加记录
. *----------------------------------------------------------------------------
> -
. quietly summarize id

. local base = r(max)

. gen long k1 = .
(113 missing values generated)

. set obs `=`n0' + `nadd''
Number of observations (_N) was 113, now 120.

. forvalues i = 1/`nadd' {
  2.     local o = `n0' + `i'
  3.     frame laws: local t  = title[`i']
  4.     frame laws: local ty = type[`i']
  5.     frame laws: local pd = publish[`i']
  6.     frame laws: local el = env_level[`i']
  7.     frame laws: local et = env_topic[`i']
  8.     frame laws: local su = url[`i']
  9. 
.     replace id           = `base' + `i'        in `o'
 10.     replace title        = "`t'"               in `o'
 11.     replace category     = "`ty'"              in `o'
 12.     replace type         = "`ty'"              in `o'
 13.     replace status       = "有效"              in `o'
 14.     replace publish      = cofd(date("`pd'","YMD"))  in `o'
 15.     replace publish_year = year(date("`pd'","YMD"))  in `o'
 16.     replace expiry       = ""                  in `o'
 17.     replace file_path    = ""                  in `o'
 18.     replace source_id    = "`su'"              in `o'
 19.     if "`el'" != "." replace env_level = real("`el'") in `o'
 20.     replace env_topic    = "`et'"              in `o'
 21.     replace env_keywords = ""                  in `o'
 22.     replace region_level = 1                   in `o'
 23.     replace province_name = "全国"             in `o'
 24.     replace province_code = .                  in `o'
 25.     replace city_name    = ""                  in `o'
 26.     replace city_code    = .                   in `o'
 27.     replace county_name  = ""                  in `o'
 28.     replace county_code  = .                   in `o'
 29.     replace dup_count    = 1                   in `o'
 30.     replace create_time  = "2026-11-05 23:05:00" in `o'
 31.     replace k1           = `i'                 in `o'
 32. }
