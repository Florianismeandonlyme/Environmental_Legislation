 opened on:   5 Nov 2026, 23:01:57

. 
. *----------------------------------------------------------------------------
> -
. * 1. 备份
. *----------------------------------------------------------------------------
> -
. capture confirm file "$root/law_env.dta"

. copy "$root/law_env.dta" "$root/law_env_premerge.dta", replace
(file /Users/florian/Desktop/博士研究计划/law_env_premerge.dta not found)

. di as txt "已备份：law_env_premerge.dta"
已备份：law_env_premerge.dta

. 
. *----------------------------------------------------------------------------
> -
. * 2. 给 national 中与地方库冲突的 id 重新编号
. *----------------------------------------------------------------------------
> -
. use "$root/law_env.dta", clear

. keep id

. tempfile locids

. save `locids'
file /var/folders/7m/37x7vvj50kb31gpc00_ww0gc0000gn/T//St06456.000001 saved
    as .dta format

. quietly summarize id

. local maxid = r(max)

. di as txt "地方库 id 最大值：" `maxid'
地方库 id 最大值：31540

. 
. use "$root/law_env_national.dta", clear

. merge m:1 id using `locids', keep(master match) gen(inloc)

    Result                      Number of obs
    -----------------------------------------
    Not matched                           119
        from master                       119  (inloc==1)
        from using                          0  (inloc==2)

    Matched                                 1  (inloc==3)
    -----------------------------------------

. quietly count if inloc == 3

. local nconf = r(N)

. di as txt "national 中与地方库冲突的 id：" `nconf' " 个"
national 中与地方库冲突的 id：1 个

. 
. if `nconf' > 0 {
.     sort inloc id
.     local next = `maxid' + 1
.     quietly levelsof id if inloc == 3, local(oldids)
.     foreach o of local oldids {
  2.         replace id = `next' if id == `o' & inloc == 3
  3.         di as txt "  id `o' -> `next'"
  4.         local ++next
  5.     }
(1 real change made)
  id 30510 -> 31541
. }

. drop inloc

. 
. * 自检：national 内部 id 唯一
. duplicates report id

