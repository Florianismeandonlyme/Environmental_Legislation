. quietly duplicates report id

. if r(unique_value) != r(N) {
.     di as err "national 内部 id 不唯一，未保存。"
.     log close
.     exit
. }

. save "$root/law_env_national.dta", replace
file /Users/florian/Desktop/博士研究计划/law_env_national.dta saved

. 
