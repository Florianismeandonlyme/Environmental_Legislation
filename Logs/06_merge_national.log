. *----------------------------------------------------------------------------
> -
. use "$root/law_env.dta", clear

. quietly count

. local nloc = r(N)

. append using "$root/law_env_national.dta"
(variable source_id was str46, now str82 to accommodate using data's values)
(label envlvl already defined)
(label reglvl already defined)

. quietly count

. local nall = r(N)

. di as txt _n "合并：`nloc' + " `nall' - `nloc' " = `nall' 条"

合并：3635 + 120 = 3755 条

. 
